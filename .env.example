# YurHedgeFundAI — environment template. Copy to .env and fill in.
# .env is gitignored; never commit real keys.

# ── LLM (required for live runs; unit tests never need it) ─────────────
# Anthropic console: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── Data providers ──────────────────────────────────────────────────────
# FRED — free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# SEC EDGAR — a descriptive User-Agent is mandatory
# (format: "Organization/Project Contact-email"); https://www.sec.gov/os/accessing-edgar-data
EDGAR_USER_AGENT="YourOrg/YurHedgeFundAI you@example.com"

# Financial Modeling Prep — OPTIONAL (free 250 req/day): https://financialmodelingprep.com
# Absent this key, the Fundamentals analyst degrades to yfinance and tags
# its signals with lower confidence.
FMP_API_KEY=

# ── Local infrastructure (docker compose up -d) ────────────────────────
DATABASE_URL=postgresql+psycopg://yhf:yhf@localhost:5432/yhf
REDIS_URL=redis://localhost:6379/0

# Where the daily brief is written (relative to the working directory)
BRIEFS_DIR=output/briefs

# ── Optional overrides ──────────────────────────────────────────────────
# Comma-separated ticker universe; default is the spec's ten starter mega-caps.
# UNIVERSE=AAPL,MSFT,NVDA,GOOGL,AMZN,META,TSLA,JPM,XOM,UNH

# Ticker → CIK for EDGAR submissions (defaults verified against the SEC's
# official company_tickers.json on 2026-09-17; override for a custom universe).
# EDGAR_CIKS=AAPL:0000320193,MSFT:0000789019,NVDA:0001045810

# Analyst name → opinion-ladder tier (Master Plan p.3); override to retune the ladder.
# AGENT_TIERS=macro_rates:2,sec_filings:3,fundamentals:4

# Model IDs live in config (locked decision 2); override here to change without code edits.
# Exact API model-ID strings are flagged for confirmation — docs/research-notes.md §a.
# ANTHROPIC_MODEL_PM=claude-opus-5
# ANTHROPIC_MODEL_ANALYST=claude-sonnet-5
